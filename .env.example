# 模型提供方：mock（默认，零 API 消耗）或 openai（任何 OpenAI 兼容平台）
CREDITGRAPH_LLM_PROVIDER=mock
CREDITGRAPH_MODEL=credit-mock
# 模型路由：可选的小/大模型档位（留空则都用 CREDITGRAPH_MODEL）
# small=材料解析/复审摘要  large=风险评估
CREDITGRAPH_MODEL_SMALL=
CREDITGRAPH_MODEL_LARGE=
# 每日 token 预算（0 = 不限制）；超限动作：block（默认）
CREDITGRAPH_DAILY_TOKEN_BUDGET=0
CREDITGRAPH_BUDGET_EXCEEDED_ACTION=block

# 接入真实模型时（provider=openai）
# DeepSeek 示例：模型名 deepseek-flash
CREDITGRAPH_OPENAI_BASE_URL=https://api.deepseek.com/v1
CREDITGRAPH_OPENAI_API_KEY=在此填写你的密钥
# 推理型模型建议留 4096，避免输出被"思考"吃光导致空回答
CREDITGRAPH_MAX_OUTPUT_TOKENS=4096

# 运行数据（默认即可）
CREDITGRAPH_DATABASE_PATH=data/creditgraph.db
CREDITGRAPH_OPERATOR=local

# 政策知识库（检索限定范围，逗号分隔）
CREDITGRAPH_POLICY_LIBRARIES=信贷政策,审批规则,风险案例,监管要求,反洗钱规则

# Embedding（向量检索）：mock（默认，确定性零成本）或 openai（OpenAI 兼容 /embeddings）
CREDITGRAPH_EMBEDDING_PROVIDER=mock
CREDITGRAPH_EMBEDDING_MODEL=text-embedding-3-small
CREDITGRAPH_EMBEDDING_DIM=256

# 单回合允许的最大工具轮数
CREDITGRAPH_MAX_TOOL_ROUNDS=4

# 工具执行：单次超时（秒）与可重试错误的最大重试次数
CREDITGRAPH_TOOL_TIMEOUT_SECONDS=10
CREDITGRAPH_TOOL_MAX_RETRIES=2

# 上下文：超过该条数后压缩较早历史
CREDITGRAPH_MAX_HISTORY_MESSAGES=24

# 上传文件大小上限（字节）
CREDITGRAPH_MAX_UPLOAD_BYTES=8000000

# 默认年化利率（用于月供试算）
CREDITGRAPH_DEFAULT_ANNUAL_RATE=0.049

# ---------------------------------------------------------------------------
# 信贷规则阈值（可配置，改这里不用改代码）
# ---------------------------------------------------------------------------
# 审批矩阵：低风险且金额低于此值 → 自动通过
CREDITGRAPH_AUTO_APPROVE_MAX_AMOUNT=100000
# 审批矩阵：金额不低于此值 → 高级审批人
CREDITGRAPH_SENIOR_REVIEW_MIN_AMOUNT=500000
# 反洗钱：金额达到此值 → 合规部门审批
CREDITGRAPH_AML_AMOUNT_THRESHOLD=2000000
# 自动拒绝：负债率上限（月负债 / 月收入）
CREDITGRAPH_MAX_DTI=0.70
# 自动拒绝：最低月收入（元）
CREDITGRAPH_MIN_MONTHLY_INCOME=3000
# 自动通过：最低信用评分
CREDITGRAPH_MIN_CREDIT_SCORE=600
# 审批超时（分钟）：超时提醒 / 升级
CREDITGRAPH_APPROVAL_TIMEOUT_MINUTES=120

# 完整规则覆盖（JSON，优先级最高，可覆盖上面未列出的字段）
# 例：CREDITGRAPH_RULES_JSON={"max_dti":0.65,"min_credit_score":620,
#     "restricted_industries":["虚拟货币","博彩"],"aml_purposes":["现金周转"]}
CREDITGRAPH_RULES_JSON=
